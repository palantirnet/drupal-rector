<?php

/**
 * @file
 * Functions to support theming in the Hook convert rector theme.
 */

require_once __DIR__ . '/includes/node.inc';

/**
 * Implements hook_preprocess_page().
 */
function hookconvertrector_theme_preprocess_page(array &$variables) {
    $variables['site_slogan_visible'] = TRUE;
}

/**
 * Implements hook_preprocess_html().
 */
function hookconvertrector_theme_preprocess_html(array &$variables) {
    $variables['attributes']['class'][] = 'hookconvertrector-theme';
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function hookconvertrector_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
    $suggestions[] = 'page__hookconvertrector_theme';
}
